{
  "name": "pkmsvv-offline",
  "version": "0.1.0",
  "private": true,
  "description": "Unendorsed noncommercial offline Windows edition of PokéSurvivor",
  "author": "PKMSVV contributors (desktop customizations); original game by JPTER78",
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:game": "node scripts/prepare-game.cjs",
    "build:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "terser": "^5.39.0"
  },
  "build": {
    "appId": "com.ronvotri.pkmsvv",
    "productName": "PKMSVV Offline",
    "copyright": "Unofficial noncommercial project; original game copyright JPTER78",
    "asar": true,
    "directories": { "output": "dist" },
    "files": [
      "desktop/**/*",
      "vendor/pokesurvivor/index.html",
      "vendor/pokesurvivor/favicon.ico",
      "vendor/pokesurvivor/manifest.webmanifest",
      "vendor/pokesurvivor/version.json",
      "vendor/pokesurvivor/js/**/*",
      "vendor/pokesurvivor/css/**/*",
      "vendor/pokesurvivor/assets/**/*",
      "vendor/pokesurvivor/LICENSE",
      "vendor/pokesurvivor/LICENSE-NONCOMMERCIAL.md",
      "vendor/pokesurvivor/CREDITS.md",
      "vendor/pokesurvivor/NOTICE-PKMSVV.txt",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "PKMSVV-${version}-Windows-x64.${ext}"
    },
    "compression": "normal"
  }
}
