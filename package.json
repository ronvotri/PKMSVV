{
  "name": "pkmsvv-offline",
  "version": "0.5.0",
  "private": true,
  "description": "Unofficial noncommercial offline Windows and Android edition of PokéSurvivor",
  "author": "PKMSVV contributors (desktop customizations); original game by JPTER78",
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:game": "node scripts/prepare-game.cjs",
    "test:evolution": "node --test tests/evolution.test.cjs",
    "build:win": "electron-builder --win portable --x64 --publish never",
    "test:i18n": "node --test tests/i18n.test.cjs",
    "test:autocast": "node --test tests/autocast.test.cjs",
    "prepare:android": "node scripts/prepare-android.cjs",
    "test:android": "node --test tests/android.test.cjs",
    "prepare:icons": "node scripts/generate-icons.cjs",
    "test:balance": "node --test tests/skill-balance.test.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "terser": "^5.39.0",
    "@capacitor/cli": "8.0.0",
    "sharp": "^0.34.5",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.ronvotri.pkmsvv",
    "productName": "PKMSVV Offline",
    "copyright": "Unofficial noncommercial project; original game copyright JPTER78",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "vendor/pokesurvivor/index.html",
      "vendor/pokesurvivor/favicon.ico",
      "vendor/pokesurvivor/manifest.webmanifest",
      "vendor/pokesurvivor/version.json",
      "vendor/pokesurvivor/js/**/*",
      "vendor/pokesurvivor/css/**/*",
      "vendor/pokesurvivor/assets/**/*",
      "vendor/pokesurvivor/LICENSE",
      "vendor/pokesurvivor/LICENSE-NONCOMMERCIAL.md",
      "vendor/pokesurvivor/CREDITS.md",
      "vendor/pokesurvivor/NOTICE-PKMSVV.txt",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "PKMSVV-${version}-Windows-x64.${ext}"
    },
    "compression": "normal"
  },
  "dependencies": {
    "@capacitor/core": "8.0.0",
    "@capacitor/android": "8.0.0"
  }
}
